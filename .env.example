# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — DOCENCIA IA UDP
# ==============================================================================

# 1. Canvas LMS UDP (Oficial)
CANVAS_API_TOKEN=tu_token_aqui
CANVAS_BASE_URL=https://udp.instructure.com

# 2. Supabase Database & Auth (PostgreSQL)
# Obtén estas credenciales en: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_public_key_aqui

# OBLIGATORIA para la capa de servidor segura (rutas /api que escriben en la base). NUNCA con prefijo NEXT_PUBLIC_.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key_aqui

# Conexión directa a Postgres (solo scripts/migrate.js, nunca en el frontend)
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PORT=5432
SUPABASE_PASSWORD=tu_password_de_base_de_datos

# 3. Parámetros de la Aplicación y Dominio
NEXT_PUBLIC_APP_NAME="Docencia IA - UDP"
NEXT_PUBLIC_UNIVERSITY="Universidad Diego Portales"

# URL base del aplicativo en producción (ej. https://docencia.udp.cl o https://mi-app.vercel.app)
# Si no se define, se detectará automáticamente el dominio en el navegador (window.location.origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Microservicio Agéntico Desacoplado (agent-services)
AGENT_SERVICES_URL=http://localhost:8080
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 5. Seguridad: Clave de Acceso Institucional Docente (rutas privadas)
APP_ACCESS_KEY=tu_clave_secreta_aqui

# Secreto para firmar sesiones y derivar el PIN del día. OBLIGATORIO, mínimo 32 caracteres, solo en el servidor.
# Si falta, las rutas protegidas fallan CERRADAS (503) y no se emite ninguna sesión.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo invalida todas las sesiones y cambia todos los PIN del día.
SESSION_SECRET=


# 6. Api Keys
OPENROUTER_API_KEY=
